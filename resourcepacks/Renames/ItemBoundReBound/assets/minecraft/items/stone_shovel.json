{
  "model": {
    "type": "minecraft:select",
	"property": "minecraft:component",
	"component": "minecraft:custom_name",
    "cases": [
      {
		"when": "Glass Shovel",
        "model": {
          "type": "minecraft:model",
          "model": "itembound:item/shovel/shovel_glass"
        }
      },
      {
		"when": "Spoon",
        "model": {
          "type": "minecraft:model",
          "model": "itembound:item/shovel/spoon"
        }
      },
      {
		"when": "Snow Shovel",
        "model": {
          "type": "minecraft:model",
          "model": "itembound:item/shovel/shovel_snow_stone"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/stone_shovel"
    }
  }
}